<%- include('partials/head', { title: title, styles: ['/css/inventory.css'] }) %>
<section class="equipment-inventory">
  <header class="inventory-heading">
    <div>
      <p class="inventory-eyebrow">EQUIPMENT MANAGEMENT</p>
      <h1>Equipments Inventory</h1>
      <p class="muted">Manage equipment, quantities, and categories.</p>
    </div>
    <% if (category) { %>
      <a class="btn inventory-clear-filter" href="/equipment">View all equipment</a>
    <% } %>
  </header>

  <section class="inventory-categories" aria-label="Equipment categories">
    <% counts.forEach(function(c) { %>
      <a class="inventory-category-card <%= category === c.name ? 'is-active' : '' %>" href="/equipment?category=<%= encodeURIComponent(c.name) %>" <%= category === c.name ? 'aria-current="page"' : '' %>>
        <span class="inventory-category-card__icon" aria-hidden="true">
          <% if (c.name === 'Audio & Visual') { %>
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="M6 8h8v5H6zM17 9v3m-8 6v2m6-2v2"></path></svg>
          <% } else if (c.name === 'Computer & Accessories') { %>
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="1.5"></rect><path d="M8 21h8m-4-4v4"></path></svg>
          <% } else if (c.name === 'Sports & Recreation') { %>
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1"></rect><circle cx="12" cy="12" r="5"></circle><path d="M12 7c2 2 2 8 0 10m0-10c-2 2-2 8 0 10"></path></svg>
          <% } else if (c.name === 'Event Supplies') { %>
            <svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z"></path><path d="M8 8h8v8H8zM8 4v4m8-4v4m-8 8v4m8-4v4"></path></svg>
          <% } else if (c.name === 'Tools & Maintenance') { %>
            <svg viewBox="0 0 24 24"><path d="m14 6 4-4 4 4-4 4m-2-2L4 20l-2-2L14 6Zm-9-3 8 8m-8-8 3-1 6 6-1 3"></path></svg>
          <% } else { %>
            <svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5M3 16l9 5 9-5"></path></svg>
          <% } %>
        </span>
        <span class="inventory-category-card__title"><%= c.name %></span>
        <span class="inventory-category-card__footer">
          <span><%= c.items %> item<%= c.items === 1 ? '' : 's' %></span>
          <span class="inventory-category-card__manage">Manage <span aria-hidden="true">→</span></span>
        </span>
      </a>
    <% }); %>
  </section>

  <section class="inventory-list-panel">
    <header class="inventory-list-panel__header">
      <div>
        <h2><%= category || 'All Equipment' %></h2>
        <p><%= items.length %> item<%= items.length === 1 ? '' : 's' %><%= category ? ' in this category' : ' in inventory' %></p>
      </div>
      <button class="btn btn-primary" type="button" id="open-add">+ Add Equipment</button>
    </header>
    <div class="inventory-table-scroll">
      <table class="table inventory-table">
        <thead><tr><th>Item Name</th><th>Category</th><th>Total Quantity</th><th>Available</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (!items.length) { %>
            <tr><td colspan="5" class="inventory-empty">No equipment in this category yet.</td></tr>
          <% } %>
          <% items.forEach(function(i) { %>
            <tr>
              <td>
                <form id="edit-<%= i.id %>" method="post" action="/equipment/<%= i.id %>/edit" class="inventory-edit-form"></form>
                <input form="edit-<%= i.id %>" name="name" value="<%= i.name %>" aria-label="Item name" disabled required>
              </td>
              <td><input form="edit-<%= i.id %>" name="category" value="<%= i.category %>" aria-label="Category" disabled required></td>
              <td><input form="edit-<%= i.id %>" name="total" type="number" min="0" value="<%= i.total %>" aria-label="Total quantity" class="inventory-quantity" disabled required></td>
              <td><strong><%= i.available %></strong></td>
              <td>
                <div class="inventory-row-actions">
                  <button class="btn btn-sm" type="button" data-edit-equipment="<%= i.id %>">Edit</button>
                  <button class="btn btn-primary btn-sm" type="submit" form="edit-<%= i.id %>" data-save-equipment="<%= i.id %>" hidden>Save</button>
                  <button class="btn btn-sm" type="button" data-cancel-equipment="<%= i.id %>" hidden>Cancel</button>
                  <form method="post" action="/equipment/<%= i.id %>/delete" class="inline" onsubmit="return confirm('Delete this item?')"><button class="btn btn-danger btn-sm" type="submit">Delete</button></form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
</section>

<dialog id="add-dialog" class="inventory-dialog">
  <form method="post" action="/equipment" class="inventory-dialog__form">
    <header class="inventory-dialog__header">
      <div><p class="inventory-eyebrow">NEW INVENTORY ITEM</p><h2>Add New Equipment</h2></div>
      <button class="inventory-dialog__close" type="button" id="close-add" aria-label="Close">×</button>
    </header>
    <div class="inventory-dialog__body">
      <label for="a-name">Item Name</label>
      <input id="a-name" name="name" required>
      <div class="inventory-add-grid">
        <div><label for="a-cat">Category</label><input id="a-cat" name="category" list="equipment-categories" placeholder="Enter or choose a category" required></div>
        <div><label for="a-qty">Quantity</label><input id="a-qty" name="quantity" type="number" min="1" value="1" required></div>
      </div>
      <datalist id="equipment-categories"><% categories.forEach(function(c) { %><option value="<%= c %>"><% }); %></datalist>
      <label for="a-spec">Specification <span>(optional)</span></label>
      <input id="a-spec" name="spec">
    </div>
    <footer class="inventory-dialog__footer">
      <button class="btn" type="button" id="cancel-add">Cancel</button>
      <button class="btn btn-primary" type="submit">Add Equipment</button>
    </footer>
  </form>
</dialog>
<script src="/js/inventory.js"></script>
<%- include('partials/foot') %>
