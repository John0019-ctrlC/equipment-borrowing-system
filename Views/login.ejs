<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · BorrowBuddy</title>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <main class="auth-card">
    <div class="auth-brand"><span class="brand-mark" aria-hidden="true">◈</span> BorrowBuddy</div>
    <h1>Welcome back</h1>
    <p class="muted">Login to start borrowing.</p>
    <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= form.email || '' %>" required autofocus>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" required>
      <button type="submit">Login</button>
    </form>
    <p class="alt">No account yet? <a href="/signup">Create one</a></p>
    <details class="demo">
      <summary>Demo accounts</summary>
      <p>admin@ccs.edu · adviser@ccs.edu · officer@ccs.edu · member@ccs.edu<br>Password: <code>password123</code></p>
    </details>
  </main>
</body>
</html>
