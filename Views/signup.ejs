<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create account · CCS OrgHub</title>
  <link rel="stylesheet" href="/css/signup.css">
</head>
<body>
  <main class="auth-card">
    <div class="auth-brand"><span class="brand-mark" aria-hidden="true">◈</span> CCS OrgHub</div>
    <h1>Create your account</h1>
    <p class="muted">We only ask for what the organization needs.</p>
    <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/signup">
      <label for="name">Full name</label>
      <input id="name" name="name" value="<%= form.name || '' %>" required>
      <div class="row">
        <div>
          <label for="schoolId">School ID</label>
          <input id="schoolId" name="schoolId" value="<%= form.schoolId || '' %>" required>
        </div>
        <div>
          <label for="course">Department / Course</label>
          <input id="course" name="course" value="<%= form.course || '' %>" placeholder="e.g. BSIT" required>
        </div>
      </div>
      <label for="orgId">Organization</label>
      <select id="orgId" name="orgId" required>
        <option value="">Select organization</option>
        <% orgs.forEach(function(o){ %>
          <option value="<%= o.id %>" <%= form.orgId === o.id ? 'selected' : '' %>><%= o.name %></option>
        <% }) %>
      </select>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= form.email || '' %>" required>
      <label for="password">Password (min. 8 characters)</label>
      <input id="password" name="password" type="password" minlength="8" required>
      <button type="submit">Create account</button>
    </form>
    <p class="alt">Already registered? <a href="/login">Sign in</a></p>
  </main>
</body>
</html>
